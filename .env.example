# Set this to the public hostname whose A/AAAA records point to the server.
ETRYROOM_DOMAIN=fit.example.com
ETRYROOM_PUBLIC_URL=https://fit.example.com

# Configure a transactional email provider for password recovery.
ETRYROOM_SMTP_HOST=smtp.example.com
ETRYROOM_SMTP_PORT=587
ETRYROOM_SMTP_MODE=starttls
ETRYROOM_SMTP_USERNAME=your-smtp-username
ETRYROOM_SMTP_PASSWORD=replace-with-provider-password
ETRYROOM_FROM_EMAIL=accounts@example.com
