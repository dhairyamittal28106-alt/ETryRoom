{
    "manifest_version": 3,
    "name": "ETryRoom Everywhere",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "declarativeContent"
    ],
    "host_permissions": [
        "*://*/*",
        "http://127.0.0.1:8000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "ETryRoom Everywhere"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}